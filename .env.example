# Portal session signing (any long random string)
PORTAL_SESSION_SECRET=change-me-to-a-long-random-string

# Supabase (free tier) — optional for local; without these, files save under .data/
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
